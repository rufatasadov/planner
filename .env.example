JWT_SECRET=change-me-to-a-long-random-string

# Host ports (change if they are already in use)
FRONTEND_PORT=5173
BACKEND_PORT=4000
DB_PORT=5433

# --- Production (server) only ---
# Enables the Caddy HTTPS proxy, which gets a Let's Encrypt certificate for DOMAIN automatically.
# COMPOSE_PROFILES=prod
# DOMAIN=onelineplanner.com
# With Caddy in front, keep the frontend port private to the server:
# FRONTEND_HOST=127.0.0.1

# Comma-separated emails that can open the admin panel
# ADMIN_EMAILS=allforaze@gmail.com

# Database password. Only takes effect when the database is created for the first time;
# for an existing database change it there too:
#   docker exec planner-db psql -U planner -c "ALTER USER planner PASSWORD 'new-password'"
# POSTGRES_PASSWORD=planner

# Allowed browser origins for the API: '*' or a comma-separated list.
# The web app is served from the same origin, so this matters for the mobile apps:
# CORS_ORIGIN=https://onelineplanner.com,capacitor://localhost,https://localhost

# Backups (service "backup", files in ./backups). Copy them off the server: scripts/db-backup-pull.sh
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=14

# Error reporting (https://sentry.io). Empty = disabled. The frontend DSN is baked in at build time.
# SENTRY_DSN=
# VITE_SENTRY_DSN=

# Public address of the web app, used in email links (verify email, reset password).
# APP_URL=https://onelineplanner.com

# Email (https://resend.com). Empty = emails are only printed to the backend log.
# The sender domain must be verified in Resend (DNS records).
# RESEND_API_KEY=
# MAIL_FROM=OneLinePlanner <no-reply@onelineplanner.com>

# Payments (https://paddle.com). Empty = checkout disabled. PADDLE_ENV: sandbox | production.
# API key and client-side token: Paddle → Developer Tools → Authentication.
# Prices and the webhook secret are printed by:
#   docker compose exec backend node src/paddle-setup.js --webhook-url https://DOMAIN/api/v1/billing/webhooks/paddle
# PADDLE_ENV=production
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_PRICE_PRO_MONTHLY=
# PADDLE_PRICE_PRO_YEARLY=
# PADDLE_WEBHOOK_SECRET=

# App Store / Play purchases. RevenueCat → Project → Integrations → Webhooks.
# URL: https://DOMAIN/api/v1/billing/webhooks/revenuecat
# The value below is sent as the Authorization header and must match exactly.
# REVENUECAT_WEBHOOK_AUTH=Bearer <random>
